*.pyc
__pycache__/
server/*.db3
server/*.db3.backup-*
server/*.pid
server/logs/*
!server/logs/.gitkeep
server/.static/
# Ignore collected/third-party static files but track our webclient source
web/static/*
!web/static/webclient/
# ...and the website theme we author (Evennia's sanctioned custom.css hook)
!web/static/website/
web/static/website/*
!web/static/website/css/
web/static/website/css/*
!web/static/website/css/custom.css
!web/static/website/fonts/
!web/static/website/fonts/**
!web/static/website/images/
!web/static/website/images/**
world/__pycache__/
typeclasses/__pycache__/
commands/__pycache__/

# Secret configuration files
server/conf/secret_settings.py

# OS generated files
.DS_Store
.vscode/settings.json

# Live-dir room-desc rollback snapshots — never commit
room_desc_snapshot_*.json

# npc_console reactive-session state (local test artifact)
*.rp_state.json
.rp_state.json
# the forum theme's bundled fonts are source, not build output
!web/discourse-theme/**

# local venv for the atlas sprite pipeline (see scripts/atlas/README.md)
scripts/atlas/.venv/
